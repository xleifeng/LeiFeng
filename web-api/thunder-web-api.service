[Unit]
Description=Thunder Native Download Web API
Wants=thunderd.service
After=thunderd.service

[Service]
Type=simple
WorkingDirectory=/opt/thunderd
Environment=THUNDERD_RUNTIME_DIR=/var/lib/thunderd
Environment=THUNDERD_DOWNLOAD_DIR=/var/lib/thunderd/downloads
ExecStart=/usr/bin/env bash /opt/thunderd/web-api/run.sh --systemd
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
