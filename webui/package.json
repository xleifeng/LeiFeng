{
  "name": "thunder-linux-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p e2e/tsconfig.json --noEmit",
    "test:ui": "vitest run tests/components tests/stores tests/composables",
    "test:e2e": "playwright test",
    "test:pixel": "playwright test e2e/pixel-diff.spec.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-virtual": "^3.13.35",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.1",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
