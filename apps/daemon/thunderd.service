[Unit]
Description=Thunder Native Download Daemon Core
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Replace /opt/thunderd with the directory containing this checkout.
# For a non-root deployment, add User=<service-user> and adjust %h/WINEPREFIX.
WorkingDirectory=/opt/thunderd
Environment=THUNDERD_RUNTIME_DIR=/var/lib/thunderd
Environment=THUNDERD_DOWNLOAD_DIR=/var/lib/thunderd/downloads
Environment=WINEPREFIX=%h/.wine-thunder
ExecStart=/usr/bin/env bash /opt/thunderd/apps/daemon/run.sh --systemd --core-only
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
